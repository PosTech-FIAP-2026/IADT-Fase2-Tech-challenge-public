# Google Maps Platform — habilite "Geocoding API" e "Routes API" no projeto do Google Cloud.
# Sem chave, o backend usa distância haversine (linha reta x fator rodoviário) como fallback.
GOOGLE_MAPS_API_KEY=

# OpenRouter (https://openrouter.ai) — usado para formatar o resultado com uma LLM.
# Sem chave, o backend gera um relatório em template simples.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Modelos reserva (separados por vírgula), tentados em ordem se o principal falhar ou der 429.
# Ex.: OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Origens permitidas pelo CORS (frontend Angular)
CORS_ORIGINS=http://localhost:4200

# Autenticação (usuário fixo). Sem estas variáveis, o padrão é admin / fiap@2026.
AUTH_USERNAME=admin
AUTH_PASSWORD=fiap@2026
# Segredo para assinar os tokens JWT. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio, um segredo aleatório é gerado a cada start e os logins expiram ao reiniciar.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
